model User {
    id       String     @id @default(uuid())
    name     String?
    phone    String?    @unique
    email    String?    @unique
    password String?
    role     UserRole
    status   UserStatus

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    lastLoginAt DateTime?
    otps        OTP[]

    @@map("users")
}
