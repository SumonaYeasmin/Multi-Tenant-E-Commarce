model Product {
  id               String        @id @default(uuid())
  tenantId         String
  title            String
  slug             String
  shortDescription String?       @db.Text
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)

  // Pricing & Cost
  price     Decimal  @default(0) @db.Decimal(12, 2)
  salePrice Decimal? @db.Decimal(12, 2)
  cost      Decimal  @default(0) @db.Decimal(12, 2)

  // Quick attributes for storefront filtering & display
  colors          Json? // [{ name: string, hex: string }]
  sizes           String[] @default([])
  brandName       String?
  subcategoryName String?

  // Shipping & Inventory flags
  weightGrams  Int     @default(0)
  barcode      String?
  preorder     Boolean @default(false)
  isNew        Boolean @default(false)
  isBestseller Boolean @default(false)

  // Social proof & metadata
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount Int      @default(0)
  sold        Int      @default(0)
  tags        String[] @default([])
  specs       Json?

  // Relations
  categoryId    String
  subcategoryId String?
  brandId       String?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category            @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category?           @relation("SubcategoryProducts", fields: [subcategoryId], references: [id], onDelete: SetNull)
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  collections ProductCollection[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlists   WishlistItem[]
  cartItems   CartItem[]

  // Auditing & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String
  color     String
  colorHex  String?
  size      String
  price     Decimal  @db.Decimal(12, 2)
  salePrice Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  reserved  Int      @default(0)
  enabled   Boolean  @default(true)
  barcode   String?

  // Optimistic Concurrency Control (Flash sales & race conditions)
  version Int @default(0)

  // Auditing & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  cartItems      CartItem[]

  @@index([productId])
  @@index([productId, deletedAt])
  @@map("product_variants")
}

model ProductCollection {
  productId    String
  collectionId String
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}
